{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nordiee Launcher",
  "version": "0.1.8",
  "identifier": "com.nordiee.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Nordiee Launcher", "width": 1280, "height": 780, "minWidth": 900, "minHeight": 620, "resizable": true, "decorations": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NkY1QTRBQzY2NDVGQTUKUldTbFgyVEdTbHB2dVgzZG5jVTFPbktGbE1oZVBJQVhDNFcrR2NkNzM3TlpmV3dwcnJlalhLbE0K",
      "endpoints": ["https://github.com/Nordiee/launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
